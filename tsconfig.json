{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@barber/api/*": ["./apps/api/*"],
      "@barber/mobile/*": ["./apps/mobile/*"]
    }
  },
  "include": ["apps/**/*"],
  "exclude": ["node_modules", "dist"]
}
